def find_data(name):
    for d in DATA_DIRS:
        p = d / name
        if p.is_file():
            return p
    return None


def log_error(msg):
    """Startup failures are otherwise invisible: `daemonize()` sends stderr to
    /dev/null, so a launch from the menu just silently does nothing."""
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        ERRLOG.write_text(f"{time.strftime('%Y-%m-%d %H:%M:%S')}  {msg}\n")
    except OSError:
        pass
    print(f"omarchy-keybind-trainer: {msg}", file=sys.stderr)


